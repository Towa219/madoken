node_modules/
dist/
data/
*.log
20260801.txt
tools/artgen/*.png
tools/soundgen/_range.json
public/sound/bgm/_preview/
public/sound/sfx/_試聴.html

# 宣伝用スクリーンショット(生成物)
tools/shots/

# 魔法一覧の元データ(生成物)
tools/spell_list.json

# 曲の置き場(ここに入れたものを public/sound/bgm/ へ移して使う)。
# 同じファイルを2つ抱えると公開リポジトリが倍の重さになるので、こちらは含めない。
#
# 先頭の / は必須。「bgm/」と書くと、どの階層の bgm フォルダにも当たってしまい、
# 本番で使う public/sound/bgm/ の曲まで巻き添えで除外される(実際にやった)。
/bgm/

# 紹介動画の中間生成物(tools/mv)。
#
# 完成品は docs/pv.mp4 だけを置く。カットごとの動画・静止画・
# タイトルの連番PNG・確認用の切り貼りは、すべて cuts.py と
# lineup.py から作り直せるので持たない。
#
# ★ 一度これを怠って、335ファイル195MBを公開リポジトリに入れてしまった。
#   とりわけ、お預かりした音楽ファイルまで公開状態になったのが問題で、
#   履歴を書き換えて消す羽目になった。生成物は必ず先に除外すること。
tools/mv/*
!tools/mv/*.py
!tools/mv/README.md
# どの曲をどこから使うかの決定。中間生成物ではなく設定なので持つ。
# これが無いと同じPVを作り直せない。
!tools/mv/bgm_choice.json
tools/mv/.vidu_key

# 名刺の生成物(tools/meishi)。
#
# ★ 位置合わせのたびに HTML と PDF を作り直してコミットしていたら、
#   1回あたり約4.6MBが履歴に積もり、10回ほどで63MBになった
#   (.git 全体で114MB)。Renderは毎回このリポジトリを取りに行く。
#   版は build_meishi.py + make_pdf.mjs から1分で作り直せるので持たない。
#   これは動画の中間生成物(tools/mv)で一度やった失敗の再来。
tools/meishi/*.html
tools/meishi/*.pdf
tools/meishi/*.png
tools/title/title_ink.svg

# Python の中間ファイル。どのフォルダにできても持たない。
__pycache__/

# 差し替え前の控え。手元で見比べるためのもので、履歴には要らない。
*.bak_*

# 検証で撮った画面写真(test/out)。
# test/*_shot.ts を走らせれば作り直せるので履歴には持たない。
# 名刺と動画で「生成物を積んで .git を膨らませた」失敗をここでも繰り返さない。
test/out/

# ペットの鳥の候補(下見用の生成物)。
# 採用した1枚は public/img/pets/ にあり、種は gen_pets.py に記録済みなので
# --all で作り直せる。候補まで持つと履歴が膨らむだけ。
tools/artgen/_pet_candidates/
